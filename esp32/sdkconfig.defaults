# Rust needs more stack than C. The default main task stack is 3 KB.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# The internal EMAC drives the LAN8720 PHY of the WT32-ETH01.
CONFIG_ETH_USE_ESP32_EMAC=y

# The web page talks to the firmware over a WebSocket.
CONFIG_HTTPD_WS_SUPPORT=y

# A direct cable to the XDJ-AZ has no DHCP server. After 3 DHCP tries, lwIP gives the port a
# 169.254.x.x address.
CONFIG_LWIP_AUTOIP=y
CONFIG_LWIP_AUTOIP_TRIES=3

# The WT32-ETH01 has 4 MB of flash.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# A 1 ms tick lets the MIDI thread sleep until 1 ms before the next clock pulse.
CONFIG_FREERTOS_HZ=1000

# The web server has 10 sockets. The firmware also needs 3 UDP sockets for Pro DJ Link, 1 TCP
# socket for the dbserver and 2 sockets for the web server itself. The default is 10.
CONFIG_LWIP_MAX_SOCKETS=20

# The MIDI thread resets the task watchdog on each loop pass. When the thread or an idle task
# stops for 5 s, the firmware restarts.
CONFIG_ESP_TASK_WDT_PANIC=y

# The bootloader starts the previous app when a new app restarts before it marks itself valid
# (see ota.rs). Flash the bootloader of this build, because the bootloader of espflash does not
# have this option.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# After a crash, the panic handler writes a core dump to the coredump partition. At the next
# start, the firmware logs the task and the backtrace, and GET /log shows them.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# The OTA download uses TLS. mbedTLS frees its record buffers after the handshake, so that the
# heap keeps space for the web server and the track data.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
