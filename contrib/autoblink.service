# systemd unit for an unattended AUTOBLINK box (for example a Raspberry Pi).
#
# Install:
#   sudo mkdir -p /opt/autoblink
#   sudo cp autoblink config.toml /opt/autoblink/
#   sudo cp autoblink.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now autoblink
#
# Read the log:
#   journalctl -u autoblink -f

[Unit]
Description=AUTOBLINK (Pro DJ Link to MIDI clock bridge)
Wants=network-online.target
After=network-online.target sound.target

[Service]
WorkingDirectory=/opt/autoblink
ExecStart=/opt/autoblink/autoblink --config /opt/autoblink/config.toml
# The app recovers from a lost MIDI device or network by itself.
# The restart is a last-resort safety net only.
Restart=on-failure
RestartSec=2
# Real-time priority keeps the MIDI clock steady on a loaded CPU.
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=50
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
